{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["@thinkhuman/biome-config/biome"],
  "files": {
    // Generated by `bun run generate:icons` (see CONTRIBUTING.md). CI regenerates them and fails on
    // any diff, so Biome must never rewrite them.
    "includes": ["**", "!src/icons", "!src/index.ts", "!src/simple-icons-manifest.json"]
  },
  "overrides": [
    {
      // The icon browser page predates Biome. These a11y findings are real but fixing them changes
      // the page markup, so they are warnings here until a follow-up addresses them.
      "includes": ["site/index.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "warn",
            "noSvgWithoutTitle": "warn",
            "noLabelWithoutControl": "warn",
            "useValidAnchor": "warn",
            "useHeadingContent": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useAnchorContent": "warn"
          }
        }
      }
    }
  ]
}
